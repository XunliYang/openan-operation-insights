# 依赖
node_modules/

# 构建产物
dist/
build/
*.tsbuildinfo

# 测试覆盖率
coverage/

# 日志
*.log
npm-debug.log*

# 环境变量（模板 .env.example 保留入库）
.env
.env.*
!.env.example

# 编辑器 / IDE
.idea/
.vscode/*
!.vscode/extensions.json

# 操作系统
.DS_Store
Thumbs.db

# 前端工具缓存
.vite/
.eslintcache

# AI 助手本地工作目录（任务计划等）
.codebuddy/

# 采集器运行时状态（游标/配额），按环境而异，不入库
data/.sync-state.json
# 数据快照
data/.snapshots/
# 手动验证采集器时的临时数据目录（collector-check.mjs 用系统临时目录，不受影响）
.tmp-collector*/
