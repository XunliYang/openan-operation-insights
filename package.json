{
  "name": "openan-operation-insights",
  "version": "1.0.0",
  "private": true,
  "description": "OpenAN 社区运营洞察平台 · 前后端一体化工程",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run start:dev -w @openan/api",
    "dev:web": "npm run dev -w @openan/web",
    "build": "npm run build -w @openan/api && npm run build -w @openan/web",
    "build:api": "npm run build -w @openan/api",
    "build:web": "npm run build -w @openan/web",
    "start": "npm run start:prod -w @openan/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
