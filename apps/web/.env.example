# API 基地址。开发期留空即可（Vite 代理 /api → :3000）；
# 同域部署时填 /api。
# ⚠️ 严禁在此文件中放置任何凭据：VITE_ 前缀变量会被编译进前端产物。
VITE_API_BASE_URL=/api

# ─── 地图底图（MarkerMap / 生态地图）────────────────────────
# 底图模式：street=瓦片 / outline=离线矢量轮廓 / auto=先瓦片、不可达自动回落轮廓，默认 auto
VITE_MAP_BASEMAP=auto
# 瓦片模板 URL（{z}/{y}/{x} 为占位符）；内网/离线部署可替换为内网瓦片服务或改 outline
VITE_MAP_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}