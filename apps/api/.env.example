# ─── 运行环境 ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# JSON 数据目录（相对仓库根或绝对路径）
DATA_DIR=../../data

# ─── 跨域（开发期由 Vite 代理，通常无需配置）───────────────
CORS_ORIGINS=http://localhost:5173

# ─── 缓存与日志 ───────────────────────────────────────────
CACHE_TTL_SECONDS=300
LOG_LEVEL=log

# ─── 地图人工层写接口（默认只读）─────────────────────────
# 未配置时写接口一律 403（WRITE_DISABLED），GET /api/maps/capabilities 返回 writable:false。
# 配置后，X-Admin-Token 请求头必须与此值一致才能调用 POST/PUT/DELETE 写接口。
MAP_WRITE_TOKEN=

# ─── GitHub 采集（阶段二 / 三）────────────────────────────
GITHUB_TOKEN=
GITHUB_ORGS=
GITHUB_REPOS=
# 兜底回溯窗口（天）：仅当本地游标缺失/损坏时生效；正常增量以 lastSyncAt 为准
GITHUB_LOOKBACK_DAYS=3650
# GraphQL 端点覆盖（GitHub Enterprise / 代理时填写；留空用 https://api.github.com/graphql）
GITHUB_API_ENDPOINT=
# 离线采集：指向固定记录 JSON 时跳过网络请求，用于无 token 验证「聚合→归属→落盘」全链路
GITHUB_FIXTURE=

# ─── 阶段三预留：Confluence 采集（本期留空）───────────────
CONFLUENCE_BASE_URL=
CONFLUENCE_TOKEN=
CONFLUENCE_SPACES=
